# CYVORA Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=cyvora-super-secret-key-change-in-production-2026

# AI LLM Provider Configuration
LLM_PROVIDER=openai # openai | anthropic | gemini | local
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gpt-4o

# Database & Cache
DATABASE_URL=sqlite:///./cyvora.db
REDIS_URL=redis://localhost:6379/0

# Sandbox Configuration
SANDBOX_MODE=subprocess # subprocess | docker
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024

# Integrations
GITHUB_TOKEN=your_github_token_here
GITLAB_TOKEN=your_gitlab_token_here
BITBUCKET_TOKEN=your_bitbucket_token_here
