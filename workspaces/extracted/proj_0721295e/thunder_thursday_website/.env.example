# Thunder Thursday Environment Variables Configuration
# Copy this file to '.env' and fill in your Firebase project credentials.
# These variables are read securely by Vite at compile time.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Production backend API server base URL (if using PostgreSQL/Express backend)
# Set to your deployed API domain, e.g., https://api.thunderthursday.com
VITE_BACKEND_API_URL=http://localhost:3000

