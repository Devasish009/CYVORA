## Database Schema (PostgreSQL)

### ER Diagram

```mermaid
erDiagram
    STATES ||--o{ CITIES : has
    STATES ||--o{ DESTINATIONS : has
    CITIES ||--o{ DESTINATIONS : has
    DESTINATIONS }o--o{ CATEGORIES : belongs_to
    DESTINATIONS ||--o{ DESTINATION_IMAGES : has

    STATES {
        int id PK
        varchar name
        varchar slug UK
        varchar capital
        varchar region
        varchar type
        text description
        text highlights
        varchar hero_image
        varchar thumbnail
        varchar best_time_to_visit
        varchar languages
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    CITIES {
        int id PK
        varchar name
        varchar slug UK
        int state_id FK
        text description
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    DESTINATIONS {
        int id PK
        varchar name
        varchar slug UK
        int state_id FK
        int city_id FK
        text description
        text historical_significance
        varchar best_time_to_visit
        varchar entry_fee
        varchar timings
        varchar address
        varchar map_link
        decimal latitude
        decimal longitude
        varchar tags
        boolean is_featured
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    CATEGORIES {
        int id PK
        varchar name
        varchar slug UK
        text description
        varchar icon
        varchar color
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    DESTINATION_CATEGORIES {
        int destination_id FK
        int category_id FK
    }

    DESTINATION_IMAGES {
        int id PK
        int destination_id FK
        varchar url
        varchar caption
        boolean is_primary
        timestamp created_at
    }

    ADMINS {
        int id PK
        varchar username UK
        varchar email UK
        varchar password_hash
        varchar full_name
        timestamp last_login
        boolean is_active
        timestamp created_at
    }
```

